<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/relativeLayout"
    android:layout_width="match_parent"
    android:layout_marginBottom="15dp"
    android:layout_marginHorizontal="60dp"
    android:paddingRight="3dp"
    android:paddingBottom="3dp"
    android:orientation="vertical"
    android:background="@drawable/shadow"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialCardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#DCDCDC"
        app:cardCornerRadius="100dp"
        app:strokeColor="#1F1F1F"
        app:strokeWidth="2dp">
        <!--TODO Доделать тень, лайаут при большом уроке чтобы текст с цифрой не уползали  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/numberTextView"
                android:layout_width="51dp"
                android:layout_height="51dp"
                android:layout_marginVertical="6dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/round_lesson_number"
                android:fontFamily="@font/manrope_bold"
                android:gravity="center"
                android:text="1"
                android:textColor="#1F1F1F"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:layout_marginLeft="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lessonTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:text="Литература"
                    android:textColor="#1F1F1F"
                    android:textSize="17sp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/timeTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/manrope_bold"
                        android:text="08:00 – 08:40"
                        android:textColor="#1F1F1F"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/teacherTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/manrope_bold"
                        android:text="38"
                        android:textColor="#1F1F1F"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>